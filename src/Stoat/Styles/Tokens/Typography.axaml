<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Styles.Resources>
        <ResourceDictionary>
            <!-- ═══════════════════════════════════════════════════════════════════════
                 TYPOGRAPHY
                 ═══════════════════════════════════════════════════════════════════════ -->

            <x:Double x:Key="FontSizeXSmall">11</x:Double>
            <x:Double x:Key="FontSizeSmall">12</x:Double>
            <x:Double x:Key="FontSizeBody">13</x:Double>
            <x:Double x:Key="FontSizeNormal">14</x:Double>
            <x:Double x:Key="FontSizeSubheading">15</x:Double>
            <x:Double x:Key="FontSizeMedium">16</x:Double>
            <x:Double x:Key="FontSizeLarge">18</x:Double>
            <x:Double x:Key="FontSizeHeading">20</x:Double>
            <x:Double x:Key="FontSizeXLarge">22</x:Double>
            <x:Double x:Key="FontSizePageTitle">24</x:Double>
            <x:Double x:Key="FontSizeHuge">72</x:Double>

            <!-- ═══════════════════════════════════════════════════════════════════════
                 SPACING & SIZING
                 ═══════════════════════════════════════════════════════════════════════ -->

            <CornerRadius x:Key="RadiusSmall">4</CornerRadius>
            <CornerRadius x:Key="RadiusMedium">6</CornerRadius>
            <CornerRadius x:Key="RadiusLarge">8</CornerRadius>
            <CornerRadius x:Key="RadiusXLarge">12</CornerRadius>
            <CornerRadius x:Key="RadiusRound">50</CornerRadius>

            <Thickness x:Key="PaddingSmall">8</Thickness>
            <Thickness x:Key="PaddingMedium">12</Thickness>
            <Thickness x:Key="PaddingLarge">20</Thickness>
        </ResourceDictionary>
    </Styles.Resources>
</Styles>
