<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Card Border -->
    <Style Selector="Border.card">
        <Setter Property="Background" Value="{DynamicResource CardBrush}"/>
        <Setter Property="CornerRadius" Value="{StaticResource RadiusLarge}"/>
        <Setter Property="Padding" Value="15"/>
        <Setter Property="BorderThickness" Value="2"/>
        <Setter Property="BorderBrush" Value="{DynamicResource CardBrush}"/>
    </Style>

    <!-- Card with visible border -->
    <Style Selector="Border.card.bordered">
        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
    </Style>

    <!-- Card Active (with teal border) -->
    <Style Selector="Border.cardActive">
        <Setter Property="Background" Value="{DynamicResource CardBrush}"/>
        <Setter Property="CornerRadius" Value="{StaticResource RadiusLarge}"/>
        <Setter Property="Padding" Value="15"/>
        <Setter Property="BorderThickness" Value="2"/>
        <Setter Property="BorderBrush" Value="{DynamicResource PrimaryBrush}"/>
    </Style>

    <!-- Warning Box -->
    <Style Selector="Border.warningBox">
        <Setter Property="Background" Value="{DynamicResource WarningBackgroundBrush}"/>
        <Setter Property="CornerRadius" Value="{StaticResource RadiusMedium}"/>
        <Setter Property="Padding" Value="12"/>
    </Style>

    <!-- Status Indicator -->
    <Style Selector="Border.statusActive">
        <Setter Property="Width" Value="12"/>
        <Setter Property="Height" Value="12"/>
        <Setter Property="CornerRadius" Value="6"/>
        <Setter Property="Background" Value="{DynamicResource PrimaryBrush}"/>
    </Style>

    <Style Selector="Border.statusInactive">
        <Setter Property="Width" Value="12"/>
        <Setter Property="Height" Value="12"/>
        <Setter Property="CornerRadius" Value="6"/>
        <Setter Property="Background" Value="{DynamicResource InfoBrush}"/>
    </Style>
</Styles>
