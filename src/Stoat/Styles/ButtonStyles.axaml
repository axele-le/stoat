<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:heroIcons="clr-namespace:HeroIconsAvalonia.Controls;assembly=HeroIconsAvalonia">

    <!-- Primary Button -->
    <Style Selector="Button.primary">
        <Setter Property="Background" Value="{DynamicResource PrimaryBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource PrimaryForegroundBrush}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Padding" Value="16,10"/>
        <Setter Property="CornerRadius" Value="{StaticResource RadiusMedium}"/>
    </Style>
    <Style Selector="Button.primary TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource PrimaryForegroundBrush}"/>
    </Style>
    <Style Selector="Button.primary:pointerover">
        <Setter Property="Background" Value="{DynamicResource PrimaryHoverBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource PrimaryForegroundBrush}"/>
    </Style>
    <Style Selector="Button.primary:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource PrimaryHoverBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource PrimaryForegroundBrush}"/>
    </Style>
    <Style Selector="Button.primary:pointerover TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource PrimaryForegroundBrush}"/>
    </Style>
    <Style Selector="Button.primary:pressed /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource PrimaryPressedBrush}"/>
    </Style>

    <!-- Secondary Button -->
    <Style Selector="Button.secondary">
        <Setter Property="Background" Value="{DynamicResource SecondaryBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource ForegroundBrush}"/>
        <Setter Property="Padding" Value="12,8"/>
        <Setter Property="CornerRadius" Value="{StaticResource RadiusMedium}"/>
    </Style>
    <Style Selector="Button.secondary TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource ForegroundBrush}"/>
    </Style>
    <Style Selector="Button.secondary:pointerover">
        <Setter Property="Foreground" Value="{DynamicResource ForegroundBrush}"/>
    </Style>
    <Style Selector="Button.secondary:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource SecondaryHoverBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource ForegroundBrush}"/>
    </Style>
    <Style Selector="Button.secondary:pointerover TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource ForegroundBrush}"/>
    </Style>
    <Style Selector="Button.secondary:pressed /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource SecondaryPressedBrush}"/>
    </Style>

    <!-- Success Button -->
    <Style Selector="Button.success">
        <Setter Property="Background" Value="{DynamicResource SuccessBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource SuccessForegroundBrush}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Padding" Value="16,10"/>
        <Setter Property="CornerRadius" Value="{StaticResource RadiusMedium}"/>
    </Style>
    <Style Selector="Button.success TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource SuccessForegroundBrush}"/>
    </Style>
    <Style Selector="Button.success:pointerover">
        <Setter Property="Foreground" Value="{DynamicResource SuccessForegroundBrush}"/>
    </Style>
    <Style Selector="Button.success:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource SuccessHoverBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource SuccessForegroundBrush}"/>
    </Style>
    <Style Selector="Button.success:pointerover TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource SuccessForegroundBrush}"/>
    </Style>
    <Style Selector="Button.success:pressed /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource SuccessPressedBrush}"/>
    </Style>

    <!-- Ghost Button (transparent with border) -->
    <Style Selector="Button.ghost">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{DynamicResource ForegroundSecondaryBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="16,10"/>
        <Setter Property="CornerRadius" Value="{StaticResource RadiusMedium}"/>
    </Style>
    <Style Selector="Button.ghost:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource SecondaryBrush}"/>
    </Style>
    <Style Selector="Button.ghost:pointerover">
        <Setter Property="Foreground" Value="{DynamicResource ForegroundBrush}"/>
    </Style>
    <Style Selector="Button.ghost:pressed /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource SecondaryPressedBrush}"/>
    </Style>

    <!-- Icon Button -->
    <Style Selector="Button.icon">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{DynamicResource ForegroundSecondaryBrush}"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Padding" Value="8,6"/>
        <Setter Property="MinWidth" Value="24"/>
        <Setter Property="MinHeight" Value="24"/>
        <Setter Property="CornerRadius" Value="{StaticResource RadiusMedium}"/>
    </Style>
    <Style Selector="Button.icon:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource SecondaryBrush}"/>
    </Style>
    <Style Selector="Button.icon:pointerover">
        <Setter Property="Foreground" Value="{DynamicResource ForegroundBrush}"/>
    </Style>
    <Style Selector="Button.icon:pressed /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource SecondaryPressedBrush}"/>
    </Style>

    <!-- Icon Button Active (teal background) -->
    <Style Selector="Button.iconActive">
        <Setter Property="Background" Value="{DynamicResource PrimaryBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource PrimaryForegroundBrush}"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Padding" Value="8,6"/>
        <Setter Property="MinWidth" Value="24"/>
        <Setter Property="MinHeight" Value="24"/>
        <Setter Property="CornerRadius" Value="{StaticResource RadiusMedium}"/>
    </Style>
    <Style Selector="Button.iconActive TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource PrimaryForegroundBrush}"/>
    </Style>
    <Style Selector="Button.iconActive:pointerover">
        <Setter Property="Foreground" Value="{DynamicResource PrimaryForegroundBrush}"/>
    </Style>
    <Style Selector="Button.iconActive:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource PrimaryHoverBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource PrimaryForegroundBrush}"/>
    </Style>
    <Style Selector="Button.iconActive:pointerover TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource PrimaryForegroundBrush}"/>
    </Style>
    <Style Selector="Button.iconActive:pressed /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource PrimaryPressedBrush}"/>
    </Style>

    <!-- HeroIcon size inside icon buttons -->
    <Style Selector="Button.icon /template/ heroIcons|HeroIcon">
        <Setter Property="Width" Value="6"/>
        <Setter Property="Height" Value="6"/>
    </Style>
    <Style Selector="Button.iconActive /template/ heroIcons|HeroIcon">
        <Setter Property="Width" Value="6"/>
        <Setter Property="Height" Value="6"/>
    </Style>

    <!-- Menu Item Button -->
    <Style Selector="Button.menuItem">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{DynamicResource ForegroundBrush}"/>
        <Setter Property="HorizontalAlignment" Value="Stretch"/>
        <Setter Property="HorizontalContentAlignment" Value="Left"/>
        <Setter Property="Padding" Value="20,15"/>
        <Setter Property="FontSize" Value="{StaticResource FontSizeNormal}"/>
    </Style>
    <Style Selector="Button.menuItem TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource ForegroundBrush}"/>
    </Style>
    <Style Selector="Button.menuItem:pointerover">
        <Setter Property="Foreground" Value="{DynamicResource ForegroundBrush}"/>
    </Style>
    <Style Selector="Button.menuItem:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource SecondaryBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource ForegroundBrush}"/>
    </Style>
    <Style Selector="Button.menuItem:pointerover TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource ForegroundBrush}"/>
    </Style>

    <!-- Tab Button Active -->
    <Style Selector="Button.tabActive">
        <Setter Property="Background" Value="{DynamicResource PrimaryBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource PrimaryForegroundBrush}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Padding" Value="16,8"/>
    </Style>
    <Style Selector="Button.tabActive TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource PrimaryForegroundBrush}"/>
    </Style>
    <Style Selector="Button.tabActive:pointerover">
        <Setter Property="Background" Value="{DynamicResource PrimaryHoverBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource PrimaryForegroundBrush}"/>
    </Style>
    <Style Selector="Button.tabActive:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource PrimaryHoverBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource PrimaryForegroundBrush}"/>
    </Style>
    <Style Selector="Button.tabActive:pointerover TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource PrimaryForegroundBrush}"/>
    </Style>
    <Style Selector="Button.tabActive:pressed /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource PrimaryPressedBrush}"/>
    </Style>

    <!-- Tab Button Inactive -->
    <Style Selector="Button.tabInactive">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{DynamicResource ForegroundSecondaryBrush}"/>
        <Setter Property="Padding" Value="16,8"/>
    </Style>
    <Style Selector="Button.tabInactive:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource SecondaryBrush}"/>
    </Style>
    <Style Selector="Button.tabInactive:pointerover">
        <Setter Property="Foreground" Value="{DynamicResource ForegroundBrush}"/>
    </Style>

    <!-- Sidebar Item -->
    <Style Selector="Button.sidebarItem">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="CornerRadius" Value="{StaticResource RadiusLarge}"/>
    </Style>
    <Style Selector="Button.sidebarItem:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource SecondaryBrush}"/>
    </Style>
    <Style Selector="Button.sidebarItem:pressed /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource SecondaryPressedBrush}"/>
    </Style>

    <!-- Sidebar Item Active -->
    <Style Selector="Button.sidebarItemActive">
        <Setter Property="Background" Value="{DynamicResource PrimaryBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource PrimaryForegroundBrush}"/>
        <Setter Property="CornerRadius" Value="{StaticResource RadiusLarge}"/>
    </Style>
    <Style Selector="Button.sidebarItemActive:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource PrimaryHoverBrush}"/>
    </Style>
</Styles>
