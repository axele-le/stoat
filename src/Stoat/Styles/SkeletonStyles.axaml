<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Skeleton Rectangle (for text/card placeholders) -->
    <Style Selector="Border.skeleton">
        <Setter Property="Background" Value="{DynamicResource SecondaryBrush}"/>
        <Setter Property="CornerRadius" Value="{StaticResource RadiusMedium}"/>
        <Style.Animations>
            <Animation Duration="0:0:1.5" IterationCount="INFINITE">
                <KeyFrame Cue="0%">
                    <Setter Property="Opacity" Value="0.3"/>
                </KeyFrame>
                <KeyFrame Cue="50%">
                    <Setter Property="Opacity" Value="0.7"/>
                </KeyFrame>
                <KeyFrame Cue="100%">
                    <Setter Property="Opacity" Value="0.3"/>
                </KeyFrame>
            </Animation>
        </Style.Animations>
    </Style>

    <!-- Skeleton Round (for icon placeholders) -->
    <Style Selector="Border.skeletonRound">
        <Setter Property="Background" Value="{DynamicResource SecondaryBrush}"/>
        <Setter Property="CornerRadius" Value="50"/>
        <Style.Animations>
            <Animation Duration="0:0:1.5" IterationCount="INFINITE">
                <KeyFrame Cue="0%">
                    <Setter Property="Opacity" Value="0.3"/>
                </KeyFrame>
                <KeyFrame Cue="50%">
                    <Setter Property="Opacity" Value="0.7"/>
                </KeyFrame>
                <KeyFrame Cue="100%">
                    <Setter Property="Opacity" Value="0.3"/>
                </KeyFrame>
            </Animation>
        </Style.Animations>
    </Style>
</Styles>
