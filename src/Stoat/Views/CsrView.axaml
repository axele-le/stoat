<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Stoat.Core.ViewModels"
             xmlns:heroIcons="clr-namespace:HeroIconsAvalonia.Controls;assembly=HeroIconsAvalonia"
             xmlns:local="clr-namespace:Stoat.Views"
             xmlns:l="using:Stoat.Localization"
             x:Class="Stoat.Views.CsrView"
             x:DataType="vm:CsrViewModel">

    <Panel>
        <!-- List View (shown when no form is open) -->
        <Grid Margin="30" RowDefinitions="Auto,*,Auto"
              IsVisible="{Binding ShowListView}">

            <!-- Header -->
            <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="0,0,0,10">
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="15">
                    <Border Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                            CornerRadius="{StaticResource RadiusLarge}"
                            Padding="12">
                        <heroIcons:HeroIcon Width="24" Height="24"
                                            Type="DocumentCheck"
                                            Kind="Outline"
                                            Foreground="{DynamicResource CSRBrush}"/>
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="{l:Translate Home.Stats.CsrLabel}"
                               FontSize="{StaticResource FontSizePageTitle}"
                               FontWeight="Bold"
                               Foreground="{DynamicResource ForegroundBrush}"/>
                        <TextBlock Text="{l:Translate Csr.Header.Subtitle}"
                               FontSize="{StaticResource FontSizeNormal}"
                               Foreground="{DynamicResource ForegroundMutedBrush}"/>
                    </StackPanel>
                </StackPanel>

                <!-- Action Buttons -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8"
                            VerticalAlignment="Center">
                    <!-- Import Button -->
                    <Button Cursor="Hand"
                            Command="{Binding OpenImportFormCommand}"
                            Classes="ghost"
                            VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <heroIcons:HeroIcon Type="ArrowUpTray" Width="16" Height="16"
                                                Foreground="{DynamicResource ForegroundSecondaryBrush}"/>
                            <TextBlock Text="{l:Translate Common.Button.Import}"/>
                        </StackPanel>
                    </Button>
                    <!-- New CSR Button -->
                    <Button Cursor="Hand"
                            Command="{Binding OpenNewCsrFormCommand}"
                            Classes="primary"
                            VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <heroIcons:HeroIcon Type="Plus" Width="16" Height="16" Foreground="{Binding $parent[Button].Foreground}"/>
                            <TextBlock Text="{l:Translate Csr.NewButton.Label}"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>

            <!-- Skeleton Loading -->
            <StackPanel Grid.Row="1" Spacing="16" Margin="0,10,0,0"
                        IsVisible="{Binding IsLoading}">
                <!-- Skeleton Group Card 1 -->
                <Border Classes="card">
                    <StackPanel Spacing="12">
                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Spacing="8">
                                <Border Classes="skeleton" Height="16" Width="200" HorizontalAlignment="Left"/>
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Border Classes="skeleton" Height="12" Width="80"/>
                                    <Border Classes="skeleton" Height="12" Width="50"/>
                                </StackPanel>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4">
                                <Border Classes="skeleton" Width="28" Height="28"/>
                                <Border Classes="skeleton" Width="28" Height="28"/>
                                <Border Classes="skeleton" Width="28" Height="28"/>
                            </StackPanel>
                        </Grid>
                        <!-- Skeleton table header -->
                        <Border Classes="skeleton" Height="36" HorizontalAlignment="Stretch"/>
                        <!-- Skeleton table rows -->
                        <Border Classes="skeleton" Height="44" HorizontalAlignment="Stretch"/>
                        <Border Classes="skeleton" Height="44" HorizontalAlignment="Stretch"/>
                    </StackPanel>
                </Border>
                <!-- Skeleton Group Card 2 -->
                <Border Classes="card">
                    <StackPanel Spacing="12">
                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Spacing="8">
                                <Border Classes="skeleton" Height="16" Width="180" HorizontalAlignment="Left"/>
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Border Classes="skeleton" Height="12" Width="70"/>
                                    <Border Classes="skeleton" Height="12" Width="40"/>
                                </StackPanel>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4">
                                <Border Classes="skeleton" Width="28" Height="28"/>
                                <Border Classes="skeleton" Width="28" Height="28"/>
                                <Border Classes="skeleton" Width="28" Height="28"/>
                            </StackPanel>
                        </Grid>
                        <Border Classes="skeleton" Height="36" HorizontalAlignment="Stretch"/>
                        <Border Classes="skeleton" Height="44" HorizontalAlignment="Stretch"/>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- Content -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                          IsVisible="{Binding !IsLoading}">
                <ScrollViewer.Transitions>
                    <Transitions>
                        <DoubleTransition Property="Opacity" Duration="0:0:0.2"/>
                    </Transitions>
                </ScrollViewer.Transitions>
                <StackPanel Spacing="20">

                    <!-- Empty State -->
                    <Border Classes="card bordered"
                            IsVisible="{Binding !HasCsrs}">
                        <StackPanel HorizontalAlignment="Center" Spacing="12">
                            <Border Background="{DynamicResource BackgroundSecondaryBrush}"
                                    CornerRadius="{StaticResource RadiusRound}"
                                    Padding="16"
                                    HorizontalAlignment="Center">
                                <heroIcons:HeroIcon Type="DocumentCheck"
                                                    Width="32" Height="32"
                                                    Foreground="{DynamicResource ForegroundMutedBrush}"/>
                            </Border>
                            <TextBlock Text="{l:Translate Csr.EmptyState.Title}"
                                       Foreground="{DynamicResource ForegroundBrush}"
                                       HorizontalAlignment="Center"
                                       FontSize="{StaticResource FontSizeLarge}"
                                       FontWeight="Medium"/>
                            <TextBlock Text="{l:Translate Csr.EmptyState.Subtitle}"
                                       Foreground="{DynamicResource ForegroundMutedBrush}"
                                       HorizontalAlignment="Center"
                                       FontSize="{StaticResource FontSizeNormal}"
                                       TextWrapping="Wrap"
                                       MaxWidth="400"
                                       TextAlignment="Center"/>
                            <Button Cursor="Hand"
                                    Command="{Binding OpenNewCsrFormCommand}"
                                    Classes="primary"
                                    Margin="0,8,0,0"
                                    HorizontalAlignment="Center">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <heroIcons:HeroIcon Type="Plus" Width="16" Height="16" Foreground="{Binding $parent[Button].Foreground}"/>
                                    <TextBlock Text="{l:Translate Csr.EmptyButton.Label}"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Border>

                    <!-- CSR Groups (grouped by Private Key) -->
                    <ItemsControl ItemsSource="{Binding CsrGroups}"
                                  IsVisible="{Binding HasCsrs}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:CsrPrivateKeyGroupViewModel">
                                <!-- Group Card -->
                                <Border Classes="card bordered"
                                        Margin="0,0,0,16">
                                    <StackPanel>
                                        <!-- Key Header -->
                                        <Border BorderBrush="{DynamicResource BorderBrush}"
                                                BorderThickness="0,0,0,1"
                                                Padding="0,0,0,12">
                                            <Grid ColumnDefinitions="Auto,*,Auto">
                                                <!-- Key Info -->
                                                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="12">
                                                    <!-- <Border Background="{DynamicResource BackgroundSecondaryBrush}"
                                                            CornerRadius="{StaticResource RadiusLarge}"
                                                            Padding="8">
                                                        <heroIcons:HeroIcon Type="Key"
                                                                            Width="16" Height="16"
                                                                            Foreground="{DynamicResource ForegroundSecondaryBrush}"/>
                                                    </Border> -->
                                                    <StackPanel VerticalAlignment="Center">
                                                        <!-- Display mode -->
                                                        <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,0,0,10"
                                                                    IsVisible="{Binding !IsEditingName}">
                                                            <TextBlock Text="{Binding DisplayName}"
                                                                       FontWeight="Medium" FontSize="{StaticResource FontSizeNormal}" Margin="0,5,0,0"
                                                                       Foreground="{DynamicResource ForegroundBrush}"/>
                                                            <Button Classes="icon"
                                                                    Cursor="Hand"
                                                                    ToolTip.Tip="{l:Translate Csr.RenameGroup.Tooltip}"
                                                                    Command="{Binding ParentViewModel.StartEditGroupNameCommand}"
                                                                    CommandParameter="{Binding}"
                                                                    Padding="2"
                                                                    VerticalAlignment="Center">
                                                                <heroIcons:HeroIcon Type="Pencil" Width="14" Height="14"
                                                                                    Foreground="{DynamicResource ForegroundMutedBrush}"/>
                                                            </Button>
                                                        </StackPanel>
                                                        <!-- Edit mode -->
                                                        <StackPanel Orientation="Horizontal" Spacing="6"  Margin="0,0,0,10"
                                                                    IsVisible="{Binding IsEditingName}">
                                                            <TextBox Text="{Binding GroupName, Mode=TwoWay}"
                                                                     Watermark="{l:Translate Csr.GroupNameWatermark}"
                                                                     Width="180"
                                                                     FontSize="{StaticResource FontSizeNormal}"
                                                                     />
                                                            <Button Classes="icon"
                                                                    Cursor="Hand"
                                                                    ToolTip.Tip="{l:Translate Common.Button.Save}"
                                                                    Command="{Binding ParentViewModel.SaveGroupNameCommand}"
                                                                    CommandParameter="{Binding}"
                                                                    Padding="4">
                                                                <heroIcons:HeroIcon Type="Check" Width="14" Height="14"
                                                                                    Foreground="{DynamicResource SuccessBrush}"/>
                                                            </Button>
                                                            <Button Classes="icon"
                                                                    Cursor="Hand"
                                                                    ToolTip.Tip="{l:Translate Common.Button.Cancel}"
                                                                    Command="{Binding ParentViewModel.CancelEditGroupNameCommand}"
                                                                    CommandParameter="{Binding}"
                                                                    Padding="4">
                                                                <heroIcons:HeroIcon Type="XMark" Width="14" Height="14"
                                                                                    Foreground="{DynamicResource DangerBrush}"/>
                                                            </Button>
                                                        </StackPanel>
                                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                                            <TextBlock Text="{Binding Algorithm}"
                                                                       FontSize="{StaticResource FontSizeSmall}"
                                                                       Foreground="{DynamicResource ForegroundMutedBrush}"/>
                                                            <TextBlock Text="•"
                                                                       FontSize="{StaticResource FontSizeSmall}"
                                                                       Foreground="{DynamicResource ForegroundMutedBrush}"/>
                                                            <TextBlock Text="{Binding CsrCountDisplay}"
                                                                       FontSize="{StaticResource FontSizeSmall}"
                                                                       Foreground="{DynamicResource ForegroundMutedBrush}"/>
                                                        </StackPanel>
                                                    </StackPanel>
                                                </StackPanel>

                                                <!-- Key Actions (only when group has private key) -->
                                                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4"
                                                            IsVisible="{Binding HasPrivateKey}">
                                                    <!-- Toggle Show Key -->
                                                    <Button Classes="icon"
                                                            Cursor="Hand"
                                                            ToolTip.Tip="{l:Translate Csr.ShowHideKey.Tooltip}"
                                                            Command="{Binding ParentViewModel.ToggleShowGroupPrivateKeyCommand}"
                                                            CommandParameter="{Binding}">
                                                        <Panel>
                                                            <heroIcons:HeroIcon Type="Eye" Width="16" Height="16" Foreground="{DynamicResource ForegroundSecondaryBrush}"
                                                                                IsVisible="{Binding !ShowPrivateKey}"/>
                                                            <heroIcons:HeroIcon Type="EyeSlash" Width="16" Height="16" Foreground="{DynamicResource ForegroundSecondaryBrush}"
                                                                                IsVisible="{Binding ShowPrivateKey}"/>
                                                        </Panel>
                                                    </Button>
                                                    <!-- Copy Key -->
                                                    <Button Classes="icon"
                                                            Cursor="Hand"
                                                            ToolTip.Tip="{l:Translate Csr.CopyPrivateKey.Tooltip}"
                                                            Command="{Binding ParentViewModel.CopyGroupPrivateKeyCommand}"
                                                            CommandParameter="{Binding}">
                                                        <Panel>
                                                            <heroIcons:HeroIcon Type="ClipboardDocument" Width="16" Height="16" Foreground="{DynamicResource ForegroundSecondaryBrush}"
                                                                                IsVisible="{Binding !IsCopied}"/>
                                                            <heroIcons:HeroIcon Type="Check" Width="16" Height="16"
                                                                                Foreground="{DynamicResource CSRBrush}"
                                                                                IsVisible="{Binding IsCopied}"/>
                                                        </Panel>
                                                    </Button>
                                                    <!-- Download Key -->
                                                    <Button Classes="icon"
                                                            Cursor="Hand"
                                                            ToolTip.Tip="{l:Translate Csr.DownloadPrivateKey.Tooltip}"
                                                            Command="{Binding ParentViewModel.DownloadGroupPrivateKeyCommand}"
                                                            CommandParameter="{Binding}">
                                                        <heroIcons:HeroIcon Type="ArrowDownTray" Width="16" Height="16" Foreground="{DynamicResource ForegroundSecondaryBrush}"/>
                                                    </Button>
                                                </StackPanel>
                                            </Grid>
                                        </Border>

                                        <!-- Private Key Preview (expanded) -->
                                        <Border Background="{DynamicResource DangerBackgroundBrush}"
                                                BorderBrush="{DynamicResource DangerBorderBrush}"
                                                BorderThickness="0,0,0,1"
                                                Padding="16"
                                                IsVisible="{Binding ShowPrivateKey}">
                                            <StackPanel Spacing="8">
                                                <StackPanel Orientation="Horizontal" Spacing="8">
                                                    <heroIcons:HeroIcon Type="ExclamationTriangle"
                                                                        Width="16" Height="16"
                                                                        Foreground="{DynamicResource DangerBrush}"/>
                                                    <TextBlock Text="{l:Translate Csr.PrivateKeyWarning}"
                                                               FontSize="{StaticResource FontSizeSmall}"
                                                               FontWeight="SemiBold"
                                                               Foreground="{DynamicResource DangerBrush}"/>
                                                </StackPanel>
                                                <Border Background="{DynamicResource BackgroundBrush}"
                                                        CornerRadius="{StaticResource RadiusMedium}"
                                                        Padding="12">
                                                    <TextBlock Text="{Binding PrivateKey}"
                                                               FontFamily="Consolas"
                                                               FontSize="{StaticResource FontSizeXSmall}"
                                                               Foreground="{DynamicResource ForegroundSecondaryBrush}"
                                                               TextWrapping="Wrap"/>
                                                </Border>
                                            </StackPanel>
                                        </Border>

                                        <!-- Loading indicator -->
                                        <Border Padding="16"
                                                IsVisible="{Binding IsLoadingPrivateKey}">
                                            <TextBlock Text="{l:Translate Csr.LoadingPrivateKey}"
                                                       FontSize="{StaticResource FontSizeBody}"
                                                       Foreground="{DynamicResource ForegroundMutedBrush}"
                                                       HorizontalAlignment="Center"/>
                                        </Border>

                                        <!-- CSR Table -->
                                        <Border Padding="0">
                                            <!-- Table Header -->
                                            <StackPanel>
                                                <Grid ColumnDefinitions="200,*,150,120,100,100"
                                                      Background="{DynamicResource BackgroundSecondaryBrush}">
                                                    <TextBlock Grid.Column="0" Text="{l:Translate Csr.Table.NameHeader}" Padding="16,10"
                                                               FontSize="{StaticResource FontSizeSmall}" FontWeight="SemiBold"
                                                               Foreground="{DynamicResource ForegroundMutedBrush}"/>
                                                    <TextBlock Grid.Column="1" Text="{l:Translate Csr.Table.SubjectHeader}" Padding="8,10"
                                                               FontSize="{StaticResource FontSizeSmall}" FontWeight="SemiBold"
                                                               Foreground="{DynamicResource ForegroundMutedBrush}"/>
                                                    <TextBlock Grid.Column="2" Text="{l:Translate Csr.Table.OrganizationHeader}" Padding="8,10"
                                                               FontSize="{StaticResource FontSizeSmall}" FontWeight="SemiBold"
                                                               Foreground="{DynamicResource ForegroundMutedBrush}"/>
                                                    <TextBlock Grid.Column="3" Text="{l:Translate Common.Label.Algorithm}" Padding="8,10"
                                                               FontSize="{StaticResource FontSizeSmall}" FontWeight="SemiBold"
                                                               Foreground="{DynamicResource ForegroundMutedBrush}"/>
                                                    <TextBlock Grid.Column="4" Text="{l:Translate Csr.Table.DateHeader}" Padding="8,10"
                                                               FontSize="{StaticResource FontSizeSmall}" FontWeight="SemiBold"
                                                               Foreground="{DynamicResource ForegroundMutedBrush}"/>
                                                    <TextBlock Grid.Column="5" Text="{l:Translate Csr.Table.ActionsHeader}" Padding="8,10"
                                                               FontSize="{StaticResource FontSizeSmall}" FontWeight="SemiBold"
                                                               Foreground="{DynamicResource ForegroundMutedBrush}"
                                                               HorizontalAlignment="Right"/>
                                                </Grid>

                                                <!-- CSR Rows -->
                                                <ItemsControl ItemsSource="{Binding Csrs}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate x:DataType="vm:CsrItemViewModel">
                                                            <StackPanel>
                                                                <!-- Main Row -->
                                                                <Border BorderBrush="{DynamicResource BorderBrush}"
                                                                        BorderThickness="0,1,0,0"
                                                                        Cursor="Hand">
                                                                    <Grid ColumnDefinitions="200,*,150,120,100,100"
                                                                          Background="Transparent">
                                                                        <Grid.Styles>
                                                                            <Style Selector="Grid:pointerover">
                                                                                <Setter Property="Background" Value="{DynamicResource BackgroundSecondaryBrush}"/>
                                                                            </Style>
                                                                        </Grid.Styles>

                                                                        <!-- Nome -->
                                                                        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8"
                                                                                    Margin="16,12,8,12" VerticalAlignment="Center">
                                                                            <heroIcons:HeroIcon Type="DocumentCheck" Width="16" Height="16"
                                                                                                Foreground="{DynamicResource CSRBrush}"/>
                                                                            <TextBlock Text="{Binding Name}"
                                                                                       FontWeight="Medium"
                                                                                       FontSize="{StaticResource FontSizeBody}"
                                                                                       Foreground="{DynamicResource ForegroundBrush}"
                                                                                       TextTrimming="CharacterEllipsis"/>
                                                                            <!-- Imported badge -->
                                                                            <Border IsVisible="{Binding IsImported}"
                                                                                    Background="{DynamicResource SecondaryBrush}"
                                                                                    CornerRadius="{StaticResource RadiusSmall}"
                                                                                    Padding="6,2">
                                                                                <TextBlock Text="{l:Translate Csr.Badge.Imported}"
                                                                                           FontSize="10"
                                                                                           Foreground="{DynamicResource ForegroundMutedBrush}"/>
                                                                            </Border>
                                                                            <!-- No private key badge -->
                                                                            <Border IsVisible="{Binding !HasPrivateKey}"
                                                                                    Background="{DynamicResource WarningTintBrush}"
                                                                                    CornerRadius="{StaticResource RadiusSmall}"
                                                                                    Padding="6,2">
                                                                                <TextBlock Text="{l:Translate Csr.Badge.NoPrivateKey}"
                                                                                           FontSize="10"
                                                                                           Foreground="{DynamicResource WarningBrush}"/>
                                                                            </Border>
                                                                        </StackPanel>

                                                                        <!-- Subject CN -->
                                                                        <Border Grid.Column="1" Margin="8,12" VerticalAlignment="Center"
                                                                                HorizontalAlignment="Left">
                                                                            <Border Background="{DynamicResource BackgroundSecondaryBrush}"
                                                                                    CornerRadius="{StaticResource RadiusSmall}"
                                                                                    Padding="6,3">
                                                                                <TextBlock Text="{Binding CommonName}"
                                                                                           FontFamily="Consolas"
                                                                                           FontSize="{StaticResource FontSizeSmall}"
                                                                                           Foreground="{DynamicResource ForegroundSecondaryBrush}"
                                                                                           TextTrimming="CharacterEllipsis"
                                                                                           MaxWidth="200"/>
                                                                            </Border>
                                                                        </Border>

                                                                        <!-- Organization -->
                                                                        <TextBlock Grid.Column="2" Text="{Binding OrganizationDisplay}"
                                                                                   Margin="8,12" VerticalAlignment="Center"
                                                                                   FontSize="{StaticResource FontSizeBody}"
                                                                                   Foreground="{DynamicResource ForegroundMutedBrush}"
                                                                                   TextTrimming="CharacterEllipsis"/>

                                                                        <!-- Signature Algorithm Badge -->
                                                                        <Border Grid.Column="3" Margin="8,12" VerticalAlignment="Center"
                                                                                HorizontalAlignment="Left"
                                                                                Background="{DynamicResource SecondaryBrush}"
                                                                                CornerRadius="{StaticResource RadiusSmall}"
                                                                                Padding="8,4">
                                                                            <TextBlock Text="{Binding SignatureAlgorithmDisplay}"
                                                                                       FontSize="{StaticResource FontSizeXSmall}"
                                                                                       Foreground="{DynamicResource ForegroundMutedBrush}"/>
                                                                        </Border>

                                                                        <!-- Date -->
                                                                        <TextBlock Grid.Column="4" Text="{Binding CreatedDateDisplay}"
                                                                                   Margin="8,12" VerticalAlignment="Center"
                                                                                   FontSize="{StaticResource FontSizeBody}"
                                                                                   Foreground="{DynamicResource ForegroundMutedBrush}"/>

                                                                        <!-- Actions -->
                                                                        <StackPanel Grid.Column="5" Orientation="Horizontal"
                                                                                    Spacing="2" Margin="8,8"
                                                                                    HorizontalAlignment="Right">
                                                                            <!-- Copy CSR -->
                                                                            <Button Classes="icon"
                                                                                    Cursor="Hand"
                                                                                    ToolTip.Tip="{l:Translate Csr.CopyCsr.Tooltip}"
                                                                                    Command="{Binding $parent[ItemsControl].((vm:CsrPrivateKeyGroupViewModel)DataContext).ParentViewModel.CopyCsrCommand}"
                                                                                    CommandParameter="{Binding}">
                                                                                <Panel>
                                                                                    <heroIcons:HeroIcon Type="ClipboardDocument" Width="14" Height="14" Foreground="{DynamicResource ForegroundSecondaryBrush}"
                                                                                                        IsVisible="{Binding !IsCopied}"/>
                                                                                    <heroIcons:HeroIcon Type="Check" Width="14" Height="14" 
                                                                                                        Foreground="{DynamicResource CSRBrush}"
                                                                                                        IsVisible="{Binding IsCopied}"/>
                                                                                </Panel>
                                                                            </Button>
                                                                            <!-- Download CSR -->
                                                                            <Button Classes="icon"
                                                                                    Cursor="Hand"
                                                                                    ToolTip.Tip="{l:Translate Csr.DownloadCsr.Tooltip}"
                                                                                    Command="{Binding $parent[ItemsControl].((vm:CsrPrivateKeyGroupViewModel)DataContext).ParentViewModel.DownloadCsrCommand}"
                                                                                    CommandParameter="{Binding}">
                                                                                <heroIcons:HeroIcon Type="ArrowDownTray" Width="14" Height="14" Foreground="{DynamicResource ForegroundSecondaryBrush}"/>
                                                                            </Button>
                                                                            <!-- Delete CSR -->
                                                                            <Button Classes="icon"
                                                                                    Cursor="Hand"
                                                                                    ToolTip.Tip="{l:Translate Common.Button.Delete}"
                                                                                    Command="{Binding $parent[ItemsControl].((vm:CsrPrivateKeyGroupViewModel)DataContext).ParentViewModel.DeleteCsrCommand}"
                                                                                    CommandParameter="{Binding Id}">
                                                                                <heroIcons:HeroIcon Type="Trash" Width="14" Height="14"
                                                                                                    Foreground="{DynamicResource DangerBrush}"/>
                                                                            </Button>
                                                                        </StackPanel>
                                                                    </Grid>
                                                                </Border>
                                                            </StackPanel>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ScrollViewer>

            <!-- Status Bar -->
            <!-- <Border Grid.Row="2"
                    Background="{DynamicResource BackgroundSecondaryBrush}"
                    CornerRadius="{StaticResource RadiusLarge}"
                    Padding="16,12"
                    Margin="0,16,0,0"
                    IsVisible="{Binding StatusMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                <Grid ColumnDefinitions="Auto,*">
                    <Panel Width="16" Height="16" Margin="0,0,12,0">
                        <heroIcons:HeroIcon Type="CheckCircle" Width="16" Height="16"
                                            Foreground="{DynamicResource SuccessBrush}"
                                            IsVisible="{Binding !IsError}"/>
                        <heroIcons:HeroIcon Type="ExclamationCircle" Width="16" Height="16"
                                            Foreground="{DynamicResource DangerBrush}"
                                            IsVisible="{Binding IsError}"/>
                    </Panel>
                    <TextBlock Grid.Column="1"
                               Text="{Binding StatusMessage}"
                               FontSize="{StaticResource FontSizeBody}"
                               Foreground="{DynamicResource ForegroundSecondaryBrush}"
                               VerticalAlignment="Center"/>
                </Grid>
            </Border> -->
        </Grid>

        <!-- Import Form View -->
        <Grid Margin="30" RowDefinitions="Auto,*,Auto"
              IsVisible="{Binding IsImportFormOpen}"
              DragDrop.AllowDrop="True">

            <!-- Import Form Header -->
            <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="0,0,0,20">
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="15">
                    <Border Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                            CornerRadius="{StaticResource RadiusLarge}"
                            Padding="12"
                            Opacity="0.9">
                        <heroIcons:HeroIcon Width="24" Height="24"
                                            Type="ArrowUpTray"
                                            Kind="Outline"
                                            Foreground="{DynamicResource CSRBrush}"/>
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="{l:Translate Csr.ImportForm.Header}"
                               FontSize="{StaticResource FontSizePageTitle}"
                               FontWeight="Bold"
                               Foreground="{DynamicResource ForegroundBrush}"/>
                        <TextBlock Text="{l:Translate Csr.ImportForm.Subtitle}"
                               FontSize="{StaticResource FontSizeNormal}"
                               Foreground="{DynamicResource ForegroundMutedBrush}"/>
                    </StackPanel>
                </StackPanel>

                <Button Grid.Column="1"
                        Cursor="Hand"
                        Command="{Binding CloseImportFormCommand}"
                        Classes="icon"
                        VerticalAlignment="Center"
                        ToolTip.Tip="{l:Translate Common.Button.Close}">
                    <heroIcons:HeroIcon Type="XMark" Width="24" Height="24" Foreground="{DynamicResource ForegroundSecondaryBrush}"/>
                </Button>
            </Grid>

            <!-- Import Form Content -->
            <ScrollViewer Grid.Row="1"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          Padding="0,20,0,0">
                <ContentControl Content="{Binding ImportFormViewModel}"
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Stretch"
                                Margin="0,0,0,20">
                    <ContentControl.ContentTemplate>
                        <DataTemplate DataType="{x:Type vm:CsrImportFormViewModel}">
                            <local:CsrImportFormView HorizontalAlignment="Stretch"/>
                        </DataTemplate>
                    </ContentControl.ContentTemplate>
                </ContentControl>
            </ScrollViewer>

            <!-- Import Form Footer -->
            <Border Grid.Row="2"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="0,0,0,0"
                    Padding="20,15">
                <Grid ColumnDefinitions="*,Auto">
                    <!-- Status Message -->
                    <!-- <Border Background="{DynamicResource BackgroundSecondaryBrush}"
                            CornerRadius="{StaticResource RadiusSmall}"
                            Padding="10,8"
                            IsVisible="{Binding ImportFormViewModel.StatusMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                            VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Panel Width="16" Height="16">
                                <heroIcons:HeroIcon Type="CheckCircle" Width="16" Height="16"
                                                    Foreground="{DynamicResource SuccessBrush}"
                                                    IsVisible="{Binding ImportFormViewModel.IsError, Converter={x:Static BoolConverters.Not}}"/>
                                <heroIcons:HeroIcon Type="ExclamationCircle" Width="16" Height="16"
                                                    Foreground="{DynamicResource DangerBrush}"
                                                    IsVisible="{Binding ImportFormViewModel.IsError}"/>
                            </Panel>
                            <TextBlock Text="{Binding ImportFormViewModel.StatusMessage}"
                                       Foreground="{DynamicResource ForegroundMutedBrush}"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border> -->

                    <!-- Action Buttons -->
                    <StackPanel Grid.Column="1"
                                Orientation="Horizontal"
                                Spacing="10">
                        <Button Cursor="Hand"
                                Command="{Binding ImportFormViewModel.CancelCommand}"
                                Classes="ghost">
                            <TextBlock Text="{l:Translate Common.Button.Cancel}"/>
                        </Button>
                        <Button Cursor="Hand"
                                Command="{Binding ImportFormViewModel.ImportCommand}"
                                IsEnabled="{Binding ImportFormViewModel.CanImport}"
                                Classes="primary">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <heroIcons:HeroIcon Type="ArrowUpTray" Width="16" Height="16" Foreground="{Binding $parent[Button].Foreground}"
                                                    IsVisible="{Binding ImportFormViewModel.IsImporting, Converter={x:Static BoolConverters.Not}}"/>
                                <heroIcons:HeroIcon Type="ArrowPath" Width="16" Height="16" Foreground="{Binding $parent[Button].Foreground}"
                                                    IsVisible="{Binding ImportFormViewModel.IsImporting}"/>
                                <TextBlock Text="{l:Translate Common.Button.Import}"
                                           IsVisible="{Binding ImportFormViewModel.IsImporting, Converter={x:Static BoolConverters.Not}}"/>
                                <TextBlock Text="{l:Translate Csr.ImportButton.Loading}"
                                           IsVisible="{Binding ImportFormViewModel.IsImporting}"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <!-- Form View (shown when form is open - full page, not modal) -->
        <Grid Margin="30" RowDefinitions="Auto,*,Auto"
              IsVisible="{Binding IsFormOpen}">

            <!-- Form Header with close button -->
            <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="0,0,0,20">
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="15">
                    <Border Background="{DynamicResource CardBrush}"
                            CornerRadius="{StaticResource RadiusLarge}"
                            Padding="12"
                            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                        <heroIcons:HeroIcon Width="24" Height="24"
                                            Type="DocumentPlus"
                                            Kind="Outline"
                                            Foreground="{DynamicResource CSRBrush}"/>
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="{l:Translate Csr.Form.Header}"
                               FontSize="{StaticResource FontSizePageTitle}"
                               FontWeight="Bold"
                               Foreground="{DynamicResource ForegroundBrush}"/>
                        <TextBlock Text="{l:Translate Csr.Form.Subtitle}"
                               FontSize="{StaticResource FontSizeNormal}"
                               Foreground="{DynamicResource ForegroundMutedBrush}"/>
                    </StackPanel>
                </StackPanel>

                <!-- Close Button (X) -->
                <Button Grid.Column="1"
                        Cursor="Hand"
                        Command="{Binding CloseFormCommand}"
                        Classes="icon"
                        VerticalAlignment="Center"
                        ToolTip.Tip="{l:Translate Common.Button.Close}">
                    <heroIcons:HeroIcon Type="XMark" Width="24" Height="24" Foreground="{DynamicResource ForegroundSecondaryBrush}"/>
                </Button>
            </Grid>

            <!-- Form Content -->
            <ScrollViewer Grid.Row="1"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          Padding="0,20,0,0">
                <ContentControl Content="{Binding FormViewModel}"
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Stretch">
                    <ContentControl.ContentTemplate>
                        <DataTemplate DataType="{x:Type vm:CsrFormViewModel}">
                            <local:CsrFormView HorizontalAlignment="Stretch"/>
                        </DataTemplate>
                    </ContentControl.ContentTemplate>
                </ContentControl>
            </ScrollViewer>

            <!-- Fixed Footer with Action Buttons -->
            <Border Grid.Row="2"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="0,0,0,0"
                    Padding="20,15">
                <Grid ColumnDefinitions="*,Auto">
                    <!-- Status Message -->
                    <!-- <Border Background="{DynamicResource BackgroundSecondaryBrush}"
                            CornerRadius="{StaticResource RadiusSmall}"
                            Padding="10,8"
                            IsVisible="{Binding FormViewModel.StatusMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                            VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Panel Width="16" Height="16">
                                <heroIcons:HeroIcon Type="CheckCircle" Width="16" Height="16"
                                                    Foreground="{DynamicResource SuccessBrush}"
                                                    IsVisible="{Binding FormViewModel.IsError, Converter={x:Static BoolConverters.Not}}"/>
                                <heroIcons:HeroIcon Type="ExclamationCircle" Width="16" Height="16"
                                                    Foreground="{DynamicResource DangerBrush}"
                                                    IsVisible="{Binding FormViewModel.IsError}"/>
                            </Panel>
                            <TextBlock Text="{Binding FormViewModel.StatusMessage}"
                                       Foreground="{DynamicResource ForegroundMutedBrush}"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border> -->

                    <!-- Action Buttons -->
                    <StackPanel Grid.Column="1"
                                Orientation="Horizontal"
                                Spacing="10">
                        <Button Cursor="Hand"
                                Command="{Binding FormViewModel.CancelCommand}"
                                Classes="ghost">
                            <TextBlock Text="{l:Translate Common.Button.Cancel}"/>
                        </Button>
                        <Button Cursor="Hand"
                                Command="{Binding FormViewModel.GenerateCsrCommand}"
                                IsEnabled="{Binding FormViewModel.IsGenerating, Converter={x:Static BoolConverters.Not}}"
                                Classes="primary">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <heroIcons:HeroIcon Type="DocumentCheck" Width="16" Height="16" Foreground="{Binding $parent[Button].Foreground}"
                                                    IsVisible="{Binding FormViewModel.IsGenerating, Converter={x:Static BoolConverters.Not}}"/>
                                <heroIcons:HeroIcon Type="ArrowPath" Width="16" Height="16"
                                                    IsVisible="{Binding FormViewModel.IsGenerating}" Foreground="{Binding $parent[Button].Foreground}"/>
                                <TextBlock Text="{l:Translate Csr.GenerateButton.Label}"
                                           IsVisible="{Binding FormViewModel.IsGenerating, Converter={x:Static BoolConverters.Not}}"/>
                                <TextBlock Text="{l:Translate Csr.GenerateButton.Loading}"
                                           IsVisible="{Binding FormViewModel.IsGenerating}"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Panel>
</UserControl>
