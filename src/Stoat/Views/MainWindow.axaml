<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:heroIcons="clr-namespace:HeroIconsAvalonia.Controls;assembly=HeroIconsAvalonia"
        xmlns:views="using:Stoat.Views"
        xmlns:l="using:Stoat.Localization"
        xmlns:local="clr-namespace:Stoat.Views"
        x:Class="Stoat.Views.MainWindow"
        Title="Stoat"
        Width="800"
        Height="600"
        >

    <Panel>
        <Grid ColumnDefinitions="Auto,*">

            <!-- ═══════════════════════════════════════════════════════════════════════
                 NUOVA SIDEBAR COLLAPSABILE
                 ═══════════════════════════════════════════════════════════════════════ -->
            <Border x:Name="Sidebar"
                    Grid.Column="0"
                    Background="{DynamicResource SidebarBrush}"
                    Width="62"
                    Padding="10,15"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="0,0,1,0">
                <Border.Transitions>
                    <Transitions>
                        <DoubleTransition Property="Width" Duration="0:0:0.25" Easing="CubicEaseOut"/>
                    </Transitions>
                </Border.Transitions>

                <Grid RowDefinitions="Auto,*,Auto">

                <!-- Logo/Header -->
                <Panel Grid.Row="0" Margin="0,0,0,30">
                        <!-- Logo e Titolo -->
                        <Grid ColumnDefinitions="Auto,*" VerticalAlignment="Center">
                            <Panel>
                                <Image x:Name="LogoDark"
                                       Source="{SvgImage avares://Stoat/Assets/Images/stoat-white.svg}"
                                       Width="40" Height="40"
                                       HorizontalAlignment="Left"/>
                                <Image x:Name="LogoLight"
                                       Source="{SvgImage avares://Stoat/Assets/Images/stoat.svg}"
                                       Width="40" Height="40"
                                       HorizontalAlignment="Left"
                                       IsVisible="False"/>
                            </Panel>
                            <!-- <Border Grid.Column="0"
                                    Width="40" Height="40"
                                    CornerRadius="{StaticResource RadiusLarge}"
                                    Background="{DynamicResource PrimaryBrush}"
                                    HorizontalAlignment="Left">
                                <heroIcons:HeroIcon Width="24" Height="24"
                                                    Type="ShieldCheck" Kind="Outline"
                                                    Foreground="{DynamicResource PrimaryForegroundBrush}"
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Center"/>
                            </Border> -->
                            <!-- Titolo (visibile solo quando espansa) -->
                            <TextBlock x:Name="SidebarTitle"
                                       Grid.Column="1"
                                       Text="{l:Translate MainWindow.Sidebar.Title}"
                                       Foreground="{DynamicResource ForegroundBrush}"
                                       FontSize="{StaticResource FontSizeLarge}"
                                       FontWeight="Bold"
                                       VerticalAlignment="Center"
                                       Margin="12,1,0,0"
                                       IsVisible="False"/>
                        </Grid>
                </Panel>

                <!-- Menu Items -->
                <StackPanel Grid.Row="1" Spacing="4">

                    <!-- Home -->
                    <Button x:Name="HomeMenuItem"
                            Click="HomeMenu_Click"
                            Classes="sidebarItem"
                            Cursor="Hand" HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Left"
                            Padding="12,10">
                        <Grid ColumnDefinitions="Auto,*">
                            <heroIcons:HeroIcon Grid.Column="0" Width="16" Height="16" Type="Home" Kind="Outline" Foreground="{DynamicResource ForegroundBrush}"/>
                            <StackPanel x:Name="HomeLabel" Grid.Column="1" Margin="12,1,0,0" IsVisible="False">
                                <TextBlock Text="{l:Translate MainWindow.Sidebar.Home}" Foreground="{DynamicResource ForegroundBrush}" FontSize="{StaticResource FontSizeSmall}"/>
                            </StackPanel>
                        </Grid>
                    </Button>

                    <!-- Encryption -->
                    <Button x:Name="EncryptionMenuItem"
                            Click="EncryptionMenu_Click"
                            Classes="sidebarItem"
                            Cursor="Hand" HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Left"
                            Padding="12,10">
                        <Grid ColumnDefinitions="Auto,*">
                            <heroIcons:HeroIcon Grid.Column="0" Width="16" Height="16" Type="LockClosed" Kind="Outline" Foreground="{DynamicResource ForegroundBrush}"/>
                            <StackPanel x:Name="EncryptionLabel" Grid.Column="1" Margin="12,1,0,0" IsVisible="False">
                                <TextBlock Text="{l:Translate MainWindow.Sidebar.Encryption}" Foreground="{DynamicResource ForegroundBrush}" FontSize="{StaticResource FontSizeSmall}"/>
                            </StackPanel>
                        </Grid>
                    </Button>

                    <!-- Hash -->
                    <Button x:Name="HashMenuItem"
                            Click="HashMenu_Click"
                            Cursor="Hand" Classes="sidebarItem"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Left"
                            Padding="12,10">
                        <Grid ColumnDefinitions="Auto,*">
                            <heroIcons:HeroIcon Grid.Column="0" Width="16" Height="16" Type="FingerPrint" Kind="Outline" Foreground="{DynamicResource ForegroundBrush}"/>
                            <StackPanel x:Name="HashLabel" Grid.Column="1" Margin="12,1,0,0" IsVisible="False">
                                <TextBlock Text="{l:Translate MainWindow.Sidebar.Hash}" Foreground="{DynamicResource ForegroundBrush}" FontSize="{StaticResource FontSizeSmall}"/>
                            </StackPanel>
                        </Grid>
                    </Button>

                    <!-- API Keys -->
                    <Button x:Name="ApiKeyMenuItem"
                            Click="ApiKeyMenu_Click"
                            Cursor="Hand" Classes="sidebarItem"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Left"
                            Padding="12,10">
                        <Grid ColumnDefinitions="Auto,*">
                            <heroIcons:HeroIcon Grid.Column="0" Width="16" Height="16" Type="Key" Kind="Outline" Foreground="{DynamicResource ForegroundBrush}"/>
                            <StackPanel x:Name="ApiKeyLabel" Grid.Column="1" Margin="12,1,0,0" IsVisible="False">
                                <TextBlock Text="{l:Translate MainWindow.Sidebar.ApiKeys}" Foreground="{DynamicResource ForegroundBrush}" FontSize="{StaticResource FontSizeSmall}"/>
                                <!-- <TextBlock Text="Genera chiavi API" Foreground="{DynamicResource ForegroundMutedBrush}" FontSize="{StaticResource FontSizeXSmall}"/> -->
                            </StackPanel>
                        </Grid>
                    </Button>

                    <!-- PEM -->
                    <Button x:Name="PemMenuItem"
                            Click="PemMenu_Click"
                            Cursor="Hand" Classes="sidebarItem"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Left"
                            Padding="12,10">
                        <Grid ColumnDefinitions="Auto,*">
                            <heroIcons:HeroIcon Grid.Column="0" Width="16" Height="16" Type="DocumentText" Kind="Outline" Foreground="{DynamicResource ForegroundBrush}"/>
                            <StackPanel x:Name="PemLabel" Grid.Column="1" Margin="12,1,0,0" IsVisible="False">
                                <TextBlock Text="{l:Translate MainWindow.Sidebar.Pem}" Foreground="{DynamicResource ForegroundBrush}" FontSize="{StaticResource FontSizeSmall}"/>
                                <!-- <TextBlock Text="Gestisci chiavi PEM" Foreground="{DynamicResource ForegroundMutedBrush}" FontSize="{StaticResource FontSizeXSmall}"/> -->
                            </StackPanel>
                        </Grid>
                    </Button>

                    <!-- CSR -->
                    <Button x:Name="CsrMenuItem"
                            Click="CsrMenu_Click"
                            Cursor="Hand" Classes="sidebarItem"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Left"
                            Padding="12,10">
                        <Grid ColumnDefinitions="Auto,*">
                            <heroIcons:HeroIcon Grid.Column="0" Width="16" Height="16" Type="DocumentCheck" Kind="Outline" Foreground="{DynamicResource ForegroundBrush}"/>
                            <StackPanel x:Name="CsrLabel" Grid.Column="1" Margin="12,1,0,0" IsVisible="False">
                                <TextBlock Text="{l:Translate MainWindow.Sidebar.Csr}" Foreground="{DynamicResource ForegroundBrush}" FontSize="{StaticResource FontSizeSmall}"/>
                            </StackPanel>
                        </Grid>
                    </Button>

                </StackPanel>

                <!-- Bottom Section - Settings -->
                <StackPanel Grid.Row="2" Spacing="4">
                    <Separator Background="{DynamicResource BorderBrush}" Margin="0,0,0,10"/>

                    <Button Click="Settings_Click"
                            Cursor="Hand" Classes="sidebarItem"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Left"
                            Padding="12,10">
                        <Grid ColumnDefinitions="Auto,*">
                            <heroIcons:HeroIcon Grid.Column="0" Width="16" Height="16" Type="Cog6Tooth" Kind="Outline" Foreground="{DynamicResource ForegroundSecondaryBrush}"/>
                            <StackPanel x:Name="SettingsLabel" Grid.Column="1" Margin="12,1,0,0" IsVisible="False">
                                <TextBlock Text="{l:Translate MainWindow.Sidebar.Settings}" Foreground="{DynamicResource ForegroundBrush}" FontSize="{StaticResource FontSizeSmall}"/>
                                <!-- <TextBlock Text="Configura profili" Foreground="{DynamicResource ForegroundMutedBrush}" FontSize="{StaticResource FontSizeXSmall}"/> -->
                            </StackPanel>
                        </Grid>
                    </Button>
                </StackPanel>

            </Grid>
        </Border>

        <!-- ═══════════════════════════════════════════════════════════════════════
             MAIN CONTENT AREA
             ═══════════════════════════════════════════════════════════════════════ -->
        <Grid Grid.Column="1" RowDefinitions="50,*">

            <!-- Header Bar -->
            <Border Grid.Row="0" Background="{DynamicResource SidebarBrush}" BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="0,0,0,1">
                <Grid ColumnDefinitions="*,Auto">
                    <!-- Spacer -->
                    <Panel Grid.Column="0"/>

                    <!-- Profile Dropdown -->
                    <Button x:Name="ProfileDropdownButton"
                            Grid.Column="1"
                            Cursor="Hand" Click="ProfileDropdown_Click"
                            Background="Transparent"
                            Padding="12,6"
                            Margin="10,0"
                            VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Border x:Name="ProfileIndicator"
                                    Width="10" Height="10"
                                    CornerRadius="5"
                                    Background="{DynamicResource ProfileActiveBrush}"
                                    VerticalAlignment="Center"/>
                            <TextBlock x:Name="ProfileNameText"
                                       
                                       Foreground="{DynamicResource ForegroundBrush}"
                                       VerticalAlignment="Center"/>
                            <heroIcons:HeroIcon Width="10" Height="10" Type="ChevronDown" Kind="Outline" Foreground="{DynamicResource ForegroundBrush}"/>
                        </StackPanel>
                    </Button>
                </Grid>
            </Border>

            <!-- Profile Dropdown Popup -->
            <Popup x:Name="ProfilePopup"
                   PlacementTarget="{Binding #ProfileDropdownButton}"
                   Placement="BottomEdgeAlignedRight"
                   IsLightDismissEnabled="True">
                <Border Background="{DynamicResource CardBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="{StaticResource RadiusLarge}"
                        Padding="8"
                        MinWidth="200">
                    <StackPanel x:Name="ProfileListPanel" Spacing="4">
                        <!-- Profiles will be added here dynamically -->
                        <Separator Background="{DynamicResource SecondaryBrush}" Margin="0,4"/>
                        <Button Content="{l:Translate MainWindow.Menu.ManageProfiles}"
                                Cursor="Hand" Click="ManageProfiles_Click"
                                Background="Transparent"
                                Foreground="{DynamicResource PrimaryBrush}"
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Left"
                                Padding="8,6"/>
                    </StackPanel>
                </Border>
            </Popup>

            <!-- Main Content -->
            <ContentControl x:Name="MainContent" Grid.Row="1">
                <Grid>
                    <!-- <TextBlock Text="CCG"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               FontSize="72"
                               FontWeight="Bold"
                               Foreground="{DynamicResource ForegroundBrush}"/> -->
                </Grid>
            </ContentControl>
        </Grid>

    </Grid>

    <!-- Toggle Button - Floating sopra tutto, sul bordo della sidebar -->
    <Button x:Name="SidebarToggleButton"
            Cursor="Hand" Click="ToggleSidebar_Click"
            Width="24" Height="24"
            HorizontalAlignment="Left"
            VerticalAlignment="Top"
            Margin="50,38,0,0"
            Padding="0"
            CornerRadius="16"
            Background="{DynamicResource CardBrush}"
            BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="1"
            ZIndex="100">
        <Button.Transitions>
            <Transitions>
                <ThicknessTransition Property="Margin" Duration="0:0:0.25" Easing="CubicEaseOut"/>
            </Transitions>
        </Button.Transitions>
        <Panel>
            <heroIcons:HeroIcon x:Name="ExpandIcon" Width="10" Height="10" Type="ChevronRight" Kind="Outline" Foreground="{DynamicResource ForegroundSecondaryBrush}"/>
            <heroIcons:HeroIcon x:Name="CollapseIcon" Width="10" Height="10" Type="ChevronLeft" Kind="Outline" Foreground="{DynamicResource ForegroundSecondaryBrush}" IsVisible="False"/>
        </Panel>
    </Button>

    <!-- Version indicator -->
    <TextBlock x:Name="VersionText"
               FontSize="{StaticResource FontSizeXSmall}"
               Foreground="{DynamicResource ForegroundMutedBrush}"
               HorizontalAlignment="Right"
               VerticalAlignment="Bottom"
               Margin="0,0,15,10"
               Opacity="0.7"/>

    <!-- Toast Notifications -->
    <ItemsControl x:Name="ToastContainer"
                  HorizontalAlignment="Center"
                  VerticalAlignment="Top"
                  Margin="0,10,0,0"
                  ZIndex="500"
                  ItemTemplate="{StaticResource ToastItemTemplate}">
        <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
                <StackPanel Spacing="8"/>
            </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
    </ItemsControl>

    <!-- Confirmation Dialog Overlay -->
    <Border x:Name="ConfirmationOverlay"
            IsVisible="False"
            Background="{DynamicResource OverlayBrush}"
            ZIndex="900"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Stretch">
        <Border Background="{DynamicResource CardBrush}"
                CornerRadius="{StaticResource RadiusXLarge}"
                Padding="32"
                MaxWidth="440"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                BoxShadow="0 8 32 0 #60000000">
            <StackPanel Spacing="20">
                <!-- Warning icon + title -->
                <StackPanel Orientation="Horizontal" Spacing="12" HorizontalAlignment="Center">
                    <heroIcons:HeroIcon Width="24" Height="24"
                                        Type="ExclamationTriangle" Kind="Outline"
                                        Foreground="{DynamicResource WarningBrush}"
                                        VerticalAlignment="Center"/>
                    <TextBlock x:Name="ConfirmationTitle"
                               Text=""
                               Foreground="{DynamicResource ForegroundBrush}"
                               FontSize="{StaticResource FontSizeLarge}"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center"/>
                </StackPanel>

                <!-- Message -->
                <TextBlock x:Name="ConfirmationMessage"
                           Text=""
                           Foreground="{DynamicResource ForegroundSecondaryBrush}"
                           FontSize="{StaticResource FontSizeNormal}"
                           TextWrapping="Wrap"
                           TextAlignment="Center"
                           HorizontalAlignment="Center"/>

                <!-- Buttons -->
                <Grid ColumnDefinitions="*,16,*" Margin="0,8,0,0">
                    <Button x:Name="ConfirmationCancelButton"
                            Grid.Column="0"
                            Content="{l:Translate Common.Button.Cancel}"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Center"
                            Padding="16,10"
                            CornerRadius="{StaticResource RadiusLarge}"
                            Background="{DynamicResource SecondaryBrush}"
                            Foreground="{DynamicResource ForegroundBrush}"
                            Cursor="Hand"/>
                    <Button x:Name="ConfirmationConfirmButton"
                            Grid.Column="2"
                            Content="{l:Translate Common.Button.Confirm}"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Center"
                            Padding="16,10"
                            CornerRadius="{StaticResource RadiusLarge}"
                            Background="{DynamicResource DangerBrush}"
                            Foreground="{DynamicResource DangerForegroundBrush}"
                            Cursor="Hand"/>
                </Grid>
            </StackPanel>
        </Border>
    </Border>

    <!-- Lock Screen Overlay -->
    <views:LockScreenOverlay x:Name="LockOverlay" ZIndex="1000"/>

    </Panel>

</Window>
